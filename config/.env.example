# ==============================================================================
# Home Assistant & Deye Ecosystem Environment Configuration Template
# ==============================================================================
# Instrukcja:
# Skopiuj ten plik do 'config/.env':
#   cp config/.env.example config/.env
# Następnie uzupełnij swoje prawdziwe dane uwierzytelniające (apiKey, hasła itp.).
# Plik '.env' jest ignorowany przez git i nie trafi do repozytorium.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Deye Inverter Hardware & Local Network
# ------------------------------------------------------------------------------
# Adres IP sticka Wi-Fi falownika Deye w Twojej sieci lokalnej LAN
DEYE_INVERTER_IP=10.20.2.6

# Port lokalny dla Modbus / Solarman V5 (domyślnie 8899)
DEYE_INVERTER_PORT=8899

# Numer seryjny sticka Wi-Fi (z obudowy sticka lub panelu www http://10.20.2.6/)
DEYE_LOGGER_SN=D26213439330

# Numer seryjny falownika (Sub-device Serial Number)
DEYE_INVERTER_SN=2603160727

# Limit czasu połączenia gniazda Modbus TCP w sekundach
DEYE_SOCKET_TIMEOUT=5.0

# Czas życia pamięci podręcznej (cache) odczytów falownika w sekundach
DEYE_CACHE_TTL_SECONDS=30.0

# Liczba pełnych dni historii zużycia domu z Deye Cloud (do wczoraj) dla godzinowego profilu obciążenia planu TOU
LOAD_HISTORY_DAYS=14

# Minimalna przerwa (godziny) między ponownymi próbami pobrania historii zużycia po błędzie Deye Cloud
DEYE_HISTORY_RETRY_HOURS=6

# ------------------------------------------------------------------------------
# 2. Deye Cloud OpenAPI (https://developer.deyecloud.com)
# ------------------------------------------------------------------------------
# Regionalny adres URL API Deye Cloud (logger-eu):
# - Europa / Polska: https://eu1-developer.deyecloud.com
# - Ameryka: https://us1-developer.deyecloud.com
# - Indie: https://india-developer.deyecloud.com
DEYE_CLOUD_API_URL=https://eu1-developer.deyecloud.com

# 1. Dane aplikacji dewelopera (z developer.deyecloud.com -> Create Application):
DEYE_CLOUD_APP_ID=twoj_app_id_tutaj
DEYE_CLOUD_APP_SECRET=twoj_app_secret_tutaj

# 2. Dane konta Deye Cloud (login i hasło do developer.deyecloud.com / aplikacji Deye):
# Oficjalne OpenAPI Deye wymaga podania konta (email + haslo), aby powiązać aplikację
# z Twoją instalacją falownika i wygenerować tymczasowy accessToken (ważny 60 dni).
# Skrypt automatycznie haszuje hasło algorytmem SHA-256 w lowercase.
DEYE_CLOUD_EMAIL=twoj_email@przyklad.pl
DEYE_CLOUD_PASSWORD=twoje_haslo_tutaj

# Opcjonalne: Gotowy token/klucz API (jeśli nie korzystasz z automatycznego logowania przez AppId/Secret):
DEYE_CLOUD_API_KEY=

# ------------------------------------------------------------------------------
# 3. Pstryk Dynamic Energy Pricing (Klucze API instalacji Dół i Góra)
# ------------------------------------------------------------------------------
PSTRYK_API_KEY_DOL=sk-xxxx
PSTRYK_API_KEY_GORA=sk-xxxx
PSTRYK_CACHE_TTL_SECONDS=900
PSTRYK_HTTP_TIMEOUT=10
ENERGY_VAT_RATE=1.23

# ------------------------------------------------------------------------------
# 4. Physical Battery Storage Hardware Specifications (Single Source of Fallback)
# ------------------------------------------------------------------------------
# Całkowita fizyczna pojemność magazynu energii (kWh)
BATTERY_CAPACITY_KWH=16.13

# Nominalne napięcie pakietu baterii (V)
BATTERY_NOMINAL_VOLTAGE=51.2

# Pojemność nominalna pakietu w amperogodzinach (Ah)
BATTERY_CAPACITY_AH=315.0

# Limit prądu ładowania (A) używany jako fallback, gdy falownik jest offline (Reg 108)
BATTERY_CHARGE_CURRENT_A=100.0
BATTERY_MAX_CHARGE_CURRENT=100.0

# Minimalny prąd ładowania (A) przy wydłużaniu okna ładowania TOU (modulacja Reg 108 nie zejdzie poniżej)
BATTERY_CHARGE_CURRENT_MIN_FLOOR_A=20.0

# Minimalna długość okna ładowania z sieci (h); okno = max(potrzeba energii, ta wartość)
CHARGE_WINDOW_MIN_HOURS=2

# Price-window charging (one window per published Warsaw price day; never on estimated prices)
# Seed: the cheapest contiguous N hours of the day
CHARGE_WINDOW_SEED_HOURS=2
# Extend the window by a neighbouring hour (cheaper neighbour first) while its price <= the window average + this (PLN/kWh)
CHARGE_WINDOW_EXTEND_PRICE_DELTA=0.05
# Extra energy margin (%) on top of the loss-corrected energy need when sizing the per-hour Reg 108 currents
CHARGE_WINDOW_ENERGY_MARGIN_PCT=5
# Reg 108 weight of the dearest window hour (the cheapest hour weighs 1.0, linear in between)
CHARGE_CURRENT_MIN_WEIGHT=0.5
# Charge taper (CC/CV + BMS): full ceiling current up to this SOC (%), then linear down to END_FRACTION * ceiling at 100 %.
# Used until the history fit (fit_charge_taper, cache key charge_taper) has BATTERY_TAPER_FIT_MIN_SAMPLES charging frames above the knee
BATTERY_CHARGE_TAPER_KNEE_SOC=90
BATTERY_CHARGE_TAPER_END_FRACTION=0.2
BATTERY_TAPER_FIT_MIN_SAMPLES=30
# Interval (min) of the TOU sync automation; the next hour's Reg 108 current is written in advance inside one interval
TOU_SYNC_INTERVAL_MIN=15

# Krok (min) zaokrąglania startu i długości doładowań przed szczytem (stabilność przy cogodzinnych przeliczeniach)
TOU_SLOT_MINUTE_STEP=5

# Krok (%) zaokrąglania w dół wyliczonych progów SOC slotów TOU (histereza: cogodzinne przeliczenia nie nadpisują falownika przy dryfie SOC)
TOU_FLOOR_SOC_STEP=5

# Krok (kW) zaokrąglania oszacowanego zużycia domu przed planowaniem TOU (histereza na wahania obciążenia)
LOAD_ESTIMATE_STEP_KW=0.1

# Limit prądu rozładowania (A) używany jako fallback, gdy falownik jest offline (Reg 109 / Max A Discharge)
BATTERY_DISCHARGE_CURRENT_A=140.0
BATTERY_MAX_DISCHARGE_CURRENT=140.0

# ------------------------------------------------------------------------------
# 5. Time-of-Use (TOU) Dispatch & SOC Parameters
# ------------------------------------------------------------------------------
DEYE_DEFAULT_MAX_SOC=90
DEYE_DEFAULT_MIN_SOC=20
DEYE_DEFAULT_SHUTDOWN_SOC=5
DEYE_DEFAULT_CURRENT_SOC=85
DEYE_DEFAULT_LOSS_BUFFER_PCT=10.0

# ------------------------------------------------------------------------------
# 6. Inverter Power Limits (Watts)
# ------------------------------------------------------------------------------
DEYE_INVERTER_MAX_POWER_W=12000
DEYE_INVERTER_MIN_POWER_W=1000
DEYE_DEFAULT_TRANSFER_POWER_W=5000
DEYE_CALIBRATION_MIN_POWER_W=3500

# ------------------------------------------------------------------------------
# 7. AI-first TOU planner (OpenAI-compatible chat API, default MiniMax)
# ------------------------------------------------------------------------------
# Klucz API (tylko w config/.env; pusty = AI wyłączone, działa algorytm)
AI_TOU_API_KEY=
AI_TOU_BASE_URL=https://api.minimax.io/v1
AI_TOU_MODEL=MiniMax-M3.1-Flash
# Wysiłek myślenia modelu (M3.1-Flash zawsze myśli; nie wysyłamy thinking:disabled)
AI_TOU_REASONING_EFFORT=low
# Limit tokenów odpowiedzi (max_completion_tokens), z zapasem na myślenie
AI_TOU_MAX_TOKENS=8192
# Limit czasu całego zapytania AI (s, zegar ścienny); AI + LOCAL_TIME_BUDGET_S musi zmieścić się w SHELL_COMMAND_TIMEOUT_S
AI_TOU_TIMEOUT_S=15
# Twardy limit Home Assistant shell_command (s); gdy brak czasu, zapytanie AI jest pomijane (ai_skipped_budget)
SHELL_COMMAND_TIMEOUT_S=60
# Ponowne zapytanie AI, gdy SOC jest o tyle % poniżej planu
AI_TOU_DEVIATION_SOC=10
# Minimalny odstęp (min) między zapytaniami po odchyleniu / po błędzie
AI_TOU_MIN_INTERVAL_MIN=60
# Odrzuć plan AI, gdy symulowany koszt > koszt algorytmu * ten współczynnik
AI_TOU_MAX_COST_RATIO=1.05
AI_TOU_CACHE_FILE=/config/.deye_ai_tou_plan.json
