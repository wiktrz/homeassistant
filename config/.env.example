# ==============================================================================
# Home Assistant & Deye Ecosystem Environment Configuration Template
# ==============================================================================
# Instrukcja:
# Skopiuj ten plik do 'config/.env' lub '.env':
#   cp config/.env.example config/.env
# Następnie uzupełnij swoje prawdziwe dane uwierzytelniające (apiKey, hasła itp.).
# Plik '.env' jest ignorowany przez git i nie trafi do repozytorium.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Deye Inverter Hardware & Local Network
# ------------------------------------------------------------------------------
# Adres IP sticka Wi-Fi falownika Deye w Twojej sieci lokalnej LAN
DEYE_INVERTER_IP=10.20.2.6

# Port lokalny dla Modbus / Solarman V5 (domyślnie 8899)
DEYE_INVERTER_PORT=8899

# Numer seryjny sticka Wi-Fi (z obudowy sticka lub panelu www http://10.20.2.6/)
DEYE_LOGGER_SN=D26213439330

# Numer seryjny falownika (Sub-device Serial Number)
DEYE_INVERTER_SN=2603160727

# Limit czasu połączenia gniazda Modbus TCP w sekundach
DEYE_SOCKET_TIMEOUT=5.0

# Czas życia pamięci podręcznej (cache) odczytów falownika w sekundach
DEYE_CACHE_TTL_SECONDS=30.0

# ------------------------------------------------------------------------------
# 2. Deye Cloud OpenAPI (https://developer.deyecloud.com)
# ------------------------------------------------------------------------------
# Regionalny adres URL API Deye Cloud (logger-eu):
# - Europa / Polska: https://eu1-developer.deyecloud.com
# - Ameryka: https://us1-developer.deyecloud.com
# - Indie: https://india-developer.deyecloud.com
DEYE_CLOUD_API_URL=https://eu1-developer.deyecloud.com

# 1. Dane aplikacji dewelopera (z developer.deyecloud.com -> Create Application):
DEYE_CLOUD_APP_ID=twoj_app_id_tutaj
DEYE_CLOUD_APP_SECRET=twoj_app_secret_tutaj

# 2. Dane konta Deye Cloud (login i hasło do developer.deyecloud.com / aplikacji Deye):
# Oficjalne OpenAPI Deye wymaga podania konta (email + haslo), aby powiązać aplikację
# z Twoją instalacją falownika i wygenerować tymczasowy accessToken (ważny 60 dni).
# Skrypt automatycznie haszuje hasło algorytmem SHA-256 w lowercase.
DEYE_CLOUD_EMAIL=twoj_email@przyklad.pl
DEYE_CLOUD_PASSWORD=twoje_haslo_tutaj

# Opcjonalne: Gotowy token/klucz API (jeśli nie korzystasz z automatycznego logowania przez AppId/Secret):
DEYE_CLOUD_API_KEY=

# ------------------------------------------------------------------------------
# 3. Pstryk Dynamic Energy Pricing (Klucze API instalacji Dół i Góra)
# ------------------------------------------------------------------------------
PSTRYK_API_KEY_DOL=sk-xxxx
PSTRYK_API_KEY_GORA=sk-xxxx
PSTRYK_CACHE_TTL_SECONDS=900
PSTRYK_HTTP_TIMEOUT=10
ENERGY_VAT_RATE=1.23

# ------------------------------------------------------------------------------
# 4. Physical Battery Storage Hardware Specifications (Single Source of Fallback)
# ------------------------------------------------------------------------------
# Całkowita fizyczna pojemność magazynu energii (kWh)
BATTERY_CAPACITY_KWH=16.13

# Nominalne napięcie pakietu baterii (V)
BATTERY_NOMINAL_VOLTAGE=51.2

# Pojemność nominalna pakietu w amperogodzinach (Ah)
BATTERY_CAPACITY_AH=315.0

# Limit prądu ładowania (A) używany jako fallback, gdy falownik jest offline (Reg 108)
BATTERY_CHARGE_CURRENT_A=100.0
BATTERY_MAX_CHARGE_CURRENT=100.0

# ------------------------------------------------------------------------------
# 5. Time-of-Use (TOU) Dispatch & SOC Parameters
# ------------------------------------------------------------------------------
DEYE_DEFAULT_MAX_SOC=90
DEYE_DEFAULT_MIN_SOC=20
DEYE_DEFAULT_SHUTDOWN_SOC=5
DEYE_DEFAULT_CURRENT_SOC=85
DEYE_DEFAULT_MORNING_RESERVE_MARGIN=10
DEYE_DEFAULT_PRE_PEAK_MARGIN=20
DEYE_DEFAULT_LOSS_BUFFER_PCT=10.0

# ------------------------------------------------------------------------------
# 6. Inverter Power Limits (Watts)
# ------------------------------------------------------------------------------
DEYE_INVERTER_MAX_POWER_W=12000
DEYE_INVERTER_MIN_POWER_W=1000
DEYE_DEFAULT_TRANSFER_POWER_W=5000
DEYE_CALIBRATION_MIN_POWER_W=3500
